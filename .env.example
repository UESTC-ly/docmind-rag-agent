# 复制为 .env 并填入真实值。.env 已被 .gitignore 排除，切勿提交真实密钥。

# 数据库
DATABASE_URL=postgresql+asyncpg://docmind:docmind123@localhost:5432/docmind_db

# Redis
REDIS_URL=redis://localhost:6379/0
TASK_EXECUTION_MODE=celery     # Web=celery；桌面 bundle 会强制覆盖为 local
LOCAL_TASK_WORKERS=2
EVALUATION_LEASE_SECONDS=2100
EVALUATION_TASK_SOFT_TIME_LIMIT_SECONDS=1740
EVALUATION_TASK_TIME_LIMIT_SECONDS=1800

# Qdrant 服务（桌面 bundle 会改用 QDRANT_PATH 本地持久化）
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=docmind_chunks
# QDRANT_PATH=./data/qdrant

# JWT
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── 对话 LLM（OpenAI 兼容）──
OPENAI_API_KEY=replace-with-your-chat-api-key
OPENAI_BASE_URL=https://your-relay-or-official/v1
CHAT_MODEL=gpt-4o-mini

# ── Embedding（可与对话不同服务，如 DashScope）──
EMBEDDING_API_KEY=replace-with-your-embedding-api-key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10

# ── 多路召回 ──
RETRIEVAL_MODE=hybrid          # dense=仅向量；hybrid=向量+关键词 RRF 融合
RRF_K=60                       # RRF 融合常数
DENSE_CANDIDATES=20            # 稠密召回候选数
KEYWORD_CANDIDATES=20          # 关键词召回候选数
RERANKER_MODE=local            # off/local/http；http 失败自动回退 local
RERANKER_CANDIDATE_LIMIT=40
# RERANKER_HTTP_URL=https://your-reranker.example/v1/rerank
# RERANKER_HTTP_API_KEY=replace-with-reranker-key
# RERANKER_HTTP_MODEL=your-cross-encoder
# RERANKER_HTTP_TIMEOUT_SECONDS=10

# ── Agent / Codex-style 通用 Skills ──
AGENT_MAX_STEPS=6
SKILL_RUNNER_MAX_STEPS=8
SKILL_WORKSPACE_DIR=./skill_workspaces

# 通用 Skill 不开放任意 shell。固定 package scripts 必须经过审计，并在 macOS
# sandbox-exec 写入隔离中运行；confinement 不可用时 capability 会 fail closed。
SKILL_PACKAGE_SCRIPTS_ENABLED=false
SKILL_PACKAGE_SCRIPT_INTERPRETERS=python,node,bash,powershell,swift
SKILL_REPOSITORY_ENABLED=false
# SKILL_REPOSITORY_ROOT=/absolute/path/to/authorized/repository

# MCP Streamable HTTP；server/tool 双 allowlist，token 从命名环境变量读取
SKILL_MCP_ENABLED=false
SKILL_MCP_SERVERS_JSON={}
# 示例：{"docs":{"url":"https://mcp.example.com/mcp","tools":["search"],"token_env":"DOCS_MCP_TOKEN"}}

# Playwright 浏览器 adapter
SKILL_BROWSER_ENABLED=false
SKILL_BROWSER_HEADLESS=true
SKILL_BROWSER_ALLOWED_HOSTS=127.0.0.1,localhost

# 本地应用 bridge（仅允许 loopback + token + app/action allowlist）
SKILL_APP_ENABLED=false
# SKILL_APP_BRIDGE_URL=http://127.0.0.1:18999
# SKILL_APP_BRIDGE_TOKEN=replace-with-local-bridge-token
SKILL_APP_ALLOWED_ACTIONS_JSON={}
SKILL_ADAPTER_OBSERVATION_MAX_CHARS=40000
SKILL_ARTIFACT_MAX_BYTES=20971520

# ── 日志 ──
LOG_LEVEL=INFO
LOG_JSON=true                  # true=结构化 JSON（生产）；false=彩色文本（本地）
