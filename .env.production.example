# Copy to .env.production. Do not commit the copied file.
# docker-compose --env-file .env.production -f docker-compose.production.yml up -d --build
DOCMIND_ENV_FILE=.env.production

POSTGRES_USER=docmind
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=docmind

# Bind the API to loopback when a host reverse proxy terminates TLS.
DOCMIND_BIND_HOST=127.0.0.1
DOCMIND_PORT=8000
CELERY_CONCURRENCY=2

SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OpenAI-compatible chat provider.
OPENAI_API_KEY=replace-with-chat-api-key
OPENAI_BASE_URL=https://your-provider.example/v1
CHAT_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_SECONDS=180
OPENAI_MAX_RETRIES=1
OPENAI_STREAM=false
OPENAI_SEND_TEMPERATURE=false

# Embedding provider. Keep EMBEDDING_DIM aligned with the selected model.
EMBEDDING_API_KEY=replace-with-embedding-api-key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10

QDRANT_COLLECTION=docmind_chunks
QDRANT_UPSERT_BATCH_SIZE=128
TASK_EXECUTION_MODE=celery
LOCAL_TASK_WORKERS=2
EVALUATION_LEASE_SECONDS=2100
EVALUATION_TASK_SOFT_TIME_LIMIT_SECONDS=1740
EVALUATION_TASK_TIME_LIMIT_SECONDS=1800

RETRIEVAL_MODE=hybrid
RRF_K=60
DENSE_CANDIDATES=20
KEYWORD_CANDIDATES=20
RERANKER_MODE=local
RERANKER_CANDIDATE_LIMIT=40
GROUNDING_VERIFICATION_MODE=llm
GROUNDING_FAIL_CLOSED=true
QUALITY_MAX_INTERVENTIONS=4
QUALITY_MIN_EVIDENCE_HITS=1
QUALITY_MIN_LOCAL_RERANK_SCORE=0.15
QUALITY_MAX_RETRIEVAL_TOP_K=20

AGENT_MAX_STEPS=6
AGENT_PLANNING_MODE=explicit
AGENT_RUN_LOCK_BACKEND=redis
AGENT_RUN_LOCK_TTL_SECONDS=300
AGENT_RUN_LOCK_HEARTBEAT_SECONDS=60
AGENT_RUN_LOCK_NAMESPACE=docmind:agent-run
AGENT_CHECKPOINT_CLEANUP_ENABLED=true
AGENT_CHECKPOINT_CLEANUP_INTERVAL_SECONDS=3600
AGENT_CHECKPOINT_COMPLETED_RETENTION_DAYS=30
AGENT_CHECKPOINT_INCOMPLETE_RETENTION_DAYS=90
AGENT_CHECKPOINT_CLEANUP_BATCH_SIZE=100

SKILL_PACKAGE_SCRIPTS_ENABLED=false
SKILL_REPOSITORY_ENABLED=false
SKILL_MCP_ENABLED=false
SKILL_BROWSER_ENABLED=false
SKILL_APP_ENABLED=false
LOG_LEVEL=INFO
LOG_JSON=true
