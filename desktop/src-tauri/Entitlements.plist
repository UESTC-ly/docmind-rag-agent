<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    The frozen one-file sidecar extracts PyInstaller-signed Python/native
    libraries at runtime. Keep the rest of hardened runtime enabled while
    allowing that managed child process to load its embedded libraries.
  -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
