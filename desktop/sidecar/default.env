# DocMind Desktop user configuration.
#
# Runtime-owned storage settings (SQLite, Qdrant local and the in-process task
# executor) are deliberately not configurable here.  The signed desktop host
# injects them so an old or copied config file cannot reconnect the packaged app
# to Docker services by accident.

# Required for chat and embeddings. Replace these placeholders with credentials
# for an OpenAI-compatible provider, then restart DocMind.
OPENAI_API_KEY=replace-with-your-chat-api-key
CHAT_MODEL=gpt-4o-mini

# Uncomment when using an OpenAI-compatible relay.
# OPENAI_BASE_URL=https://your-relay.example/v1

# Optional independent embedding provider.
# EMBEDDING_API_KEY=replace-with-your-embedding-api-key
# EMBEDDING_BASE_URL=https://your-embedding-provider.example/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_BATCH_SIZE=10

RETRIEVAL_MODE=hybrid
RRF_K=60
KEYWORD_CANDIDATES=20

# Signed, package-owned Python helpers run through the sidecar's resource-root
# validator. Other interpreters remain unavailable unless a custom host bundles
# and explicitly authorizes them.
SKILL_PACKAGE_SCRIPTS_ENABLED=true
SKILL_PACKAGE_SCRIPT_INTERPRETERS=python
SKILL_PACKAGE_SCRIPT_ENV_ALLOWLIST=HOME,TMPDIR,TEMP,PATH

# LangGraph checkpoint 路径由签名 sidecar 强制放入用户 data_dir；这里仅声明
# 哪些外层 Skill / Generic package capabilities 在执行前必须人工审批。
AGENT_HIGH_RISK_SKILLS=
AGENT_HIGH_RISK_CAPABILITIES=package_scripts,mcp,browser,app,repository

LOG_LEVEL=INFO
LOG_JSON=true
